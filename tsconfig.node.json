{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "*.config.*",
    "eslint.*",
    "cypress/eslint.config.*",
    "cypress/package.d.ts",
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "vite/client",
    ]
  }
}
