{
  "extends": [
    "./tsconfig.common.json",
    "@tsconfig/node24/tsconfig.json"
  ],
  "include": [
    "*.config.*",
    "eslint.*",
    "cypress/eslint.config.*",
    "@internal/**/*",
    "eslint-internal/**/*.ts",
    "TSMorph/**/*.ts",
    "vitest/**/*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "vite/client"
    ],
    "allowImportingTsExtensions": true
  }
}
